# Anthropic API — reasoning kernel
ANTHROPIC_API_KEY=sk-ant-...

# Polygon.io — ticker-tagged news (needs Starter plan or higher)
POLYGON_API_KEY=

# Telegram bot — push notifications for score >= 7
# See TELEGRAM_SETUP.md for how to get these
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email digest — daily summary of score 4-6 items
# Use a Gmail app password or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
DIGEST_TO_EMAIL=your.email@gmail.com

# Runtime config
CLAUDE_MODEL=claude-sonnet-4-6
RELEVANCE_PUSH_THRESHOLD=7
RELEVANCE_DIGEST_MIN=4
MARKET_HOURS_ONLY=true
